{
  "name": "soniox-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Soniox App (Smart Scribe) meeting transcripts to Claude",
  "type": "module",
  "main": "dist/src/stdio.js",
  "bin": {
    "soniox-mcp-server": "dist/src/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/stdio.js",
    "start:http": "node dist/src/http.js",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "test:client": "tsx scripts/test-client.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vercel/blob": "^2.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
